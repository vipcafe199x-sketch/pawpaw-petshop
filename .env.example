APP_ENV=development
APP_SECRET=replace-with-a-random-64-character-secret
DATABASE_PATH=./data/pawpaw.sqlite3
ADMIN_EMAIL=
ADMIN_PASSWORD=
PUBLIC_BASE_URL=http://127.0.0.1:8000
CADDY_SITE=:80

# Production normally refuses to create a missing database. Set to 1 only for a deliberate first installation.
ALLOW_DATABASE_INIT=0
